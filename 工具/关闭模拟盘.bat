@echo off
chcp 65001 >nul
title 关闭 PVC 双均线模拟盘
echo ============================================================
echo  关闭 PVC 双均线模拟盘
echo   (按命令行精确匹配，只杀这一个脚本的进程)
echo ============================================================
echo.
:: 命令用 Base64(UTF-16LE) 传入 —— cmd 传中文给 powershell 会乱码，
:: 实测「任务跑完但进程没死」就是栽在这里。Base64 是纯 ASCII，不会再乱。
powershell -NoProfile -ExecutionPolicy Bypass -EncodedCommand 
echo.
:: auto = 计划任务调用(不暂停)；手动双击(无参数)-> 保留 pause
if "%~1"=="" pause
exit /b 0
